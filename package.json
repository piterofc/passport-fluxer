  "license": "MIT",
  "author": "piterofc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piterofc/passport-fluxer.git"
  },
  "homepage": "https://github.com/piterofc/passport-fluxer#readme",
  "bugs": { "url": "https://github.com/piterofc/passport-fluxer/issues" },
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./package.json": "./package.json"
